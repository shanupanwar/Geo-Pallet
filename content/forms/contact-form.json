    { "id": "heat", "type": "radio", "label": "Heat treated Pallets", "width": "half", "choices": ["Yes", "No"] },
    { "id": "qty", "type": "select", "label": "Estimated quantity required?", "required": true, "width": "half", "choices": ["50–100", "100–500", "500+"] },
