  "fields": [
    {
      "id": "name",
      "type": "text",
      "label": "Full name",
      "required": true,
      "width": "half",
      "autocomplete": "name",
      "validate": "fullName"
    },
    {
      "id": "email",
      "type": "email",
      "label": "Business email",
      "required": true,
      "width": "half",
      "autocomplete": "email"
    },
    {
      "id": "phone",
      "type": "phone",
      "label": "Phone number",
      "required": true,
      "width": "half"
    },
    {
      "id": "company",
      "type": "text",
      "label": "Company name",
      "required": true,
      "width": "half",
